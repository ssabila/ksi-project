DATABASE_URL=mysql+pymysql://root:password@localhost/sdms

# WAJIB diisi. Buat dengan: python generate_secrets.py
# Aplikasi menolak start jika masih placeholder / tidak valid.
JWT_SECRET_KEY=ganti_dengan_hasil_generate_secrets
DB_AES_KEY=ganti_dengan_hasil_generate_secrets

# Hanya untuk demo lokal. Jika true, kunci development bawaan boleh dipakai.
SDMS_ALLOW_INSECURE_DEFAULTS=false
FLASK_DEBUG=0

UPLOAD_DIR=storage
RSA_PRIVATE_KEY_PATH=keys/private.pem
RSA_PUBLIC_KEY_PATH=keys/public.pem
SEED_DEMO_USERS=true
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_DOSEN_PASSWORD=Dosen123!
DEMO_MAHASISWA_PASSWORD=Mahasiswa123!
SSL_CERT_FILE=certs/cert.pem
SSL_KEY_FILE=certs/key.pem

# Untuk SQLite demo: DATABASE_URL=sqlite:///sdms.db
